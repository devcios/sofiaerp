<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="tippic_qa_control_de_calidad_form" model="ir.ui.view">
        <field name="name">tippic.qa.quality_control.form</field>
        <field name="model">tippic_qa.quality_control</field>
        <field name="arch" type="xml">

            <form string="Punto de Control">
                <header>
                    <button name="action_confirm" string="Confirmar" type="object" class="oe_highlight"
                        attrs="{'invisible': ['|', ('state', '=', 'confirm'), ('state', '=', 'done')]}"/>
                    <button name="action_terminar" string="Terminar" type="object" class="oe_highlight"
                        attrs="{'invisible': [('state', '=', 'done')]}"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Terminado" bg_color="bg-success" attrs="{'invisible': [('state', '!=', 'done')]}"/>
                    <widget name="web_ribbon" title="Cancelado" bg_color="bg-danger" attrs="{'invisible': [('state', '!=', 'cancel')]}"/>
                    <div class="oe_title w">
                        <label for="name"/>
                        <h3>
                            <field name="name" placeholder="New" attrs="{'readonly': [('state', '=', 'done')]}"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="type"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="origin"/>
                            <field name="move_id"/>
                        </group>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Pruebas de Calidad" name="quality_tests">
                            <field name="tests">
                                <tree string="Pruebas" editable="top" delete="false">
                                    <field name="date"/>
                                    <field name="quality_point"/>
                                    <field name="product_id"/>
                                    <field name="fulfillment"/>
                                    <field name="nonconformity"/>
                                    <field name="tag_ids"/>
                                    <field name="state"/>
                                    <button
                                            name="mark_pass"
                                            title="Aprobar"
                                            icon="fa-check-circle"
                                            type="object"
                                            attrs="{'invisible': [('fulfillment', '!=', False)]}"
                                    />
                                    <button
                                            name="mark_fail"
                                            title="Fallo"
                                            icon="fa-times-circle"
                                            type="object"
                                            attrs="{'invisible': [('fulfillment', '!=', False)]}"
                                    />
                                </tree>
                            </field>
                        </page>
                        <page string="Destinity Line Moves" name="quality_destinity_lines">
                            <field name="move_line_dest_ids">
                                <tree string="Movimientos" editable="top" delete="false">
                                    <field name="date" readonly="1"/>
                                    <field name="reference" readonly="1"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="company_id" invisible="1"/>
                                    <field name="product_uom_category_id" invisible="1"/>
                                    <field name="location_id" readonly="1"/>
                                    <field name="location_dest_id" readonly="1"/>
                                    <field name="qty_done" readonly="1"/>
                                    <field name="lot_id" readonly="1"/>
                                    <field name="product_uom_id" readonly="1"/>
                                    <field name="state" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Otros" name="quality_others">
                            <group>
                                <group>
                                    <field name="production_id"/>
                                    <field name="lot_id"/>
                                </group>
                                <group>
                                    <field name="user_id"/>
                                    <field name="company_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>

		<div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>

            </form>
        </field>
    </record>

    <record id="tippic_qa_tests_tree" model="ir.ui.view">
        <field name="name">tippic.qa.quality_control.tree</field>
        <field name="model">tippic_qa.quality_control</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="product_id"/>
                <field name="production_id"/>
                <field name="type"/>
		<field name="state"/>
            </tree>
        </field>
    </record>

    <record id="action_tippic_qa_tests" model="ir.actions.act_window">
        <field name="name">Control de Calidad</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tippic_qa.quality_control</field>
        <field name="view_mode">tree,form,calendar</field>
        <field name="view_id" ref="tippic_qa_tests_tree"/>
    </record>

    <record id="action_tippic_qa_calendar" model="ir.actions.act_window">
        <field name="name">Calendar</field>
        <field name="res_model">tippic_qa.quality_control</field>
        <field name="view_mode">calendar</field>
    </record>

</odoo>
