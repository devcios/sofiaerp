<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tippic_qa_control_point_form" model="ir.ui.view">
        <field name="name">tippic.qa.controlPoint.form</field>
        <field name="model">tippic_qa.control_point</field>
        <field name="arch" type="xml">
            <form string="Punto de Control">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <widget name="web_ribbon" title="Activo" bg_color="bg-success" attrs="{'invisible': [('active', '=', False)]}"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h3><field name="name" placeholder="Name"/></h3>
                    </div>

                    <group>
                        <group>
                            <field name="product_ids" widget="many2many_tags"/>
                            <field name="type" widget="radio"/>
                            <field name="quantity_min" attrs="{'invisible': [('type', '!=', 'quantity')]}"/>
                            <field name="quantity_max" attrs="{'invisible': [('type', '!=', 'quantity')]}"/>
                        </group>
                        <group>
                            <group>
                                <field name="trigger_time" widget="many2many_tags"/>
                                <field name="sequence"/>
                                <field name="delay"/>
                            </group>
                            <group>
                                <field name="nonconformity_type" widget="radio"/>
                            </group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tippic_qa_punto_de_control_tree" model="ir.ui.view">
        <field name="name">tippic.qa.controlPoint.tree</field>
        <field name="model">tippic_qa.control_point</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="type"/>
                <field name="nonconformity_type"/>
                <field name="product_ids" widget='many2many_tags'/>
                <field name="delay"/>
            </tree>
        </field>
    </record>

    <record id="action_tippic_qa_punto_de_control" model="ir.actions.act_window">
        <field name="name">Puntos de Control</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tippic_qa.control_point</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="tippic_qa_punto_de_control_tree"/>
    </record>

</odoo>