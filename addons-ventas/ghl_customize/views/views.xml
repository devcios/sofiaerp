        </record>
	<record model="sale.condition" id="sale_condition_6">
            <field name="consideration">El servicio se realizara dentro de planta Santa Anita</field>
            <field name="area">mntto</field>
            <field name="si_no">no</field>
            <field name="accion">Requiere informe y guias de remision</field>
        </record>

          </data>
</odoo>